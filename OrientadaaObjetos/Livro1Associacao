import java.util.ArrayList;

public class Livro {
    private String titulo;
    private ArrayList<Autoria> autorias; // Lista de vínculos

    public Livro(String titulo) {
        this.titulo = titulo;
        this.autorias = new ArrayList<>();
    }

    public String getTitulo() { return titulo; }

    public void adicionarAutoria(Autoria autoria) {
        this.autorias.add(autoria);
    }

    public ArrayList<Autoria> getAutorias() { return autorias; }
}
