public class Atuacao {
    private Ator ator;
    private Filme filme;
    private String personagem; // Atributo próprio do vínculo

    public Atuacao(Ator ator, Filme filme, String personagem) {
        this.ator = ator;
        this.filme = filme;
        this.personagem = personagem;
    }

    public Ator getAtor() { return ator; }
    public Filme getFilme() { return filme; }
    public String getPersonagem() { return personagem; }

    // Método estático para criar e sincronizar as duas pontas
    public static Atuacao atuar(Ator ator, Filme filme, String personagem) {
        Atuacao a = new Atuacao(ator, filme, personagem);
        ator.adicionarAtuacao(a);
        filme.adicionarAtuacao(a);
        return a;
    }
}
