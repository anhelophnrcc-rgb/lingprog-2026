public class Gerente extends Funcionario {
    private double bonusGerencial;

    public Gerente(String nome, double salario, double bonusGerencial) {
        super(nome, salario); // Constrói a parte de Funcionario primeiro
        this.bonusGerencial = bonusGerencial;
    }

    @Override
    public double calcularBonus() {
        // super.calcularBonus() chama os 5% da classe mãe e soma o bônus do gerente
        return super.calcularBonus() + bonusGerencial; 
    }
}
